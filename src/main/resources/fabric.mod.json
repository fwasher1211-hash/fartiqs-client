{
  "schemaVersion": 1,
  "id": "fartiqsclient",
  "version": "1.0.0",
  "name": "Fartiqs Client",
  "description": "All Fartiqs mods in one client. Press Right Shift to open the menu and toggle them.",
  "authors": ["Fartiqs"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["com.fartiqs.client.FartiqsClient"]
  },
  "mixins": ["fartiqsclient.mixins.json"],
  "jars": [
    { "file": "META-INF/jars/fartiqs-profit-hud-1.0.10.jar" },
    { "file": "META-INF/jars/fartiqs-2x-pay-mod-1.0.0.jar" },
    { "file": "META-INF/jars/fartiqs-auction-mod-3.4.0.jar" }
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
